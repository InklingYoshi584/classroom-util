{
  "name": "classroom-receiver",
  "version": "1.5.1",

  "private": true,
  "type": "module",
  "description": "Classroom Receiver — MQTT-based classroom notification display with TTS and homework tracking",
  "author": "InklingYoshi584",
  "repository": "github:InklingYoshi584/classroom-util",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:package": "vite build && electron-builder --win portable",
    "electron:dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.classroom.receiver",
    "productName": "Classroom Receiver",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "ClassroomReceiver-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "mqtt": "^5.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
